{
  "log_dir": "./logs",
  "filename_pattern": "trace.log",
  "rotation": {
    "strategy": "size",
    "max_bytes": 10000000,
    "backup_count": 5
  },
  "enabled_scopes": [
    "TOOL_CALL",
    "MODEL_CALL_START",
    "MODEL_CALL_END",
    "ASSISTANT_TEXT",
    "USER_INPUT",
    "FULL_TURN",
    "ERROR",
    "INFO",
    "WARNING",
    "DEBUG"
  ]
}
